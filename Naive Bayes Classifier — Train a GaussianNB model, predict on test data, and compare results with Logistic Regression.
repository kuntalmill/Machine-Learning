from sklearn.datasets import load_breast_cancer
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import accuracy_score, classification_report
from sklearn.model_selection import train_test_split
from sklearn.naive_bayes import GaussianNB
from sklearn.preprocessing import StandardScaler

# Load dataset and split into train/test sets
data = load_breast_cancer()
X_train, X_test, y_train, y_test = train_test_split(
    data.data, data.target, test_size=0.2, random_state=42
)

# Scale features for Logistic Regression
scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled = scaler.transform(X_test)

# Train Logistic Regression (from Task 3)
log_reg = LogisticRegression(random_state=42)
log_reg.fit(X_train_scaled, y_train)

# Train Gaussian Naive Bayes (Task 4)
gnb = GaussianNB()
gnb.fit(X_train, y_train)

# Predictions on test data
y_pred_gnb = gnb.predict(X_test)
y_pred_lr = log_reg.predict(X_test_scaled)

# Accuracy scores
acc_gnb = accuracy_score(y_test, y_pred_gnb)
acc_lr = accuracy_score(y_test, y_pred_lr)

print(f"GaussianNB Test Accuracy: {acc_gnb:.4f}")
print(f"Logistic Regression Test Accuracy: {acc_lr:.4f}")
print("\nGaussianNB Classification Report:")
print(classification_report(y_test, y_pred_gnb, target_names=data.target_names))
print("\nLogistic Regression Classification Report:")
print(classification_report(y_test, y_pred_lr, target_names=data.target_names))
